; Engine configuration file.
; It's best edited using the editor UI and not directly.

config_version=5

[application]
config/name="Arcade Maze Fantasy"
config/description="A fantasy horror maze arcade game with 68 levels, 17 bosses, 51 mini-bosses, and 28 enemy types."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=Porter
config/icon="res://assets/sprites/player1_sheet.png"

[autoload]
GameManager="*res://scripts/core/GameManager.gd"
SpriteManager="*res://scripts/core/SpriteManager.gd"
ConfigManager="*res://scripts/core/ConfigManager.gd"
AudioManager="*res://scripts/audio/AudioManager.gd"

[display]
window/size/viewport_width=1024
window/size/viewport_height=1024
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[input]
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194320,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false)
]
}
