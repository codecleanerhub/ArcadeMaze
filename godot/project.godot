; Engine configuration file.
; It's best edited using the editor UI and not directly.

config_version=5

[application]

config/name="Arcade Maze Fantasy"
config/description="A fantasy horror maze arcade game with 68 levels, 17 bosses, 51 mini-bosses, and 28 enemy types."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/sprites/player1_sheet.png"

[editor]

text_editor/theme/indent_use_spaces=true
text_editor/theme/indent_size=8

[autoload]
BootManager="*res://scripts/core/BootManager.gd"
GameManager="*res://scripts/core/GameManager.gd"
SpriteManager="*res://scripts/core/SpriteManager.gd"
ConfigManager="*res://scripts/core/ConfigManager.gd"
AudioManager="*res://scripts/audio/AudioManager.gd"
EffectsManager="*res://scripts/core/EffectsManager.gd"
EnvironmentArt="*res://scripts/core/EnvironmentArt.gd"
CharacterArt="*res://scripts/core/CharacterArt.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

